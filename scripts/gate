#!/usr/bin/env python3
"""The gate: everything a change to this repository must pass.

Quiet on success; prints each problem and exits 1 on failure.
"""

import re
import shutil
import subprocess
import sys
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parent.parent
problems = []


def files(pattern):
    return sorted(p for p in ROOT.rglob(pattern) if ".git" not in p.relative_to(ROOT).parts)


def check_ref(source, ref):
    """Report a relative reference from `source` that does not resolve to a file."""
    ref = ref.strip()
    if not ref or ref.startswith("//"):
        return
    parts = urlsplit(ref)
    if parts.scheme or not parts.path:  # absolute URL, mailto:, data:, or fragment-only
        return
    path = unquote(parts.path)
    if path.startswith("/"):
        problems.append(f"{source.relative_to(ROOT)}: root-relative reference '{ref}' breaks under /frontier-design-entwurf/")
        return
    target = source.parent / path
    if target.is_dir():
        target = target / "index.html"
    if not target.is_file():
        problems.append(f"{source.relative_to(ROOT)}: broken reference '{ref}'")


def srcset_urls(srcset):
    """URLs of a srcset attribute, following the HTML spec's candidate parsing."""
    urls, i = [], 0
    while i < len(srcset):
        while i < len(srcset) and (srcset[i].isspace() or srcset[i] == ","):
            i += 1
        start = i
        while i < len(srcset) and not srcset[i].isspace():
            i += 1
        url = srcset[start:i]
        if url.endswith(","):
            url = url.rstrip(",")
        else:  # skip descriptors up to the next comma outside parentheses
            depth = 0
            while i < len(srcset) and not (srcset[i] == "," and depth == 0):
                depth += {"(": 1, ")": -1}.get(srcset[i], 0)
                i += 1
        if url:
            urls.append(url)
    return urls


class Page(HTMLParser):
    def __init__(self):
        super().__init__()
        self.refs = []
        self.robots = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        for name in ("href", "src"):
            if attrs.get(name):
                self.refs.append(attrs[name])
        self.refs += srcset_urls(attrs.get("srcset") or "")
        if tag == "meta" and (attrs.get("name") or "").lower() == "robots":
            self.robots.append((attrs.get("content") or "").replace(" ", "").lower())


# 1. Every relative reference in the pages and stylesheets points to a file in the build.
# 2. Every page stays out of search engines.
for html in files("*.html"):
    page = Page()
    page.feed(html.read_text(encoding="utf-8"))
    for ref in page.refs:
        check_ref(html, ref)
    if not any({"noindex", "nofollow"} <= set(r.split(",")) for r in page.robots):
        problems.append(f"{html.relative_to(ROOT)}: missing <meta name=\"robots\" content=\"noindex,nofollow\">")

for css in files("*.css"):
    for ref in re.findall(r"""url\(\s*['"]?([^'")]*)['"]?\s*\)""", css.read_text(encoding="utf-8")):
        check_ref(css, ref)

if "Disallow: /" not in (ROOT / "robots.txt").read_text(encoding="utf-8").splitlines():
    problems.append("robots.txt: must contain 'Disallow: /'")

# 3. Secret scan of the working tree.
if not shutil.which("gitleaks"):
    problems.append("gitleaks not found; install it with scripts/install-gitleaks and put ~/.local/bin on PATH")
elif subprocess.run(
    ["gitleaks", "dir", str(ROOT), "--no-banner", "--redact", "--verbose", "--log-level", "error"]
).returncode:
    problems.append("gitleaks found possible secrets (see above)")

for problem in problems:
    print(f"gate: {problem}", file=sys.stderr)
sys.exit(1 if problems else 0)
